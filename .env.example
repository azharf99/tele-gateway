# Telegram API Credentials (default shared credentials; optional per-account overrides in Web UI)
TELEGRAM_APP_ID=12345
TELEGRAM_APP_HASH=abcdef1234567890
TELEGRAM_SESSION_FILE=session/session.json
TELEGRAM_SESSION_DIR=session
# Legacy Account #1 auto-migration (optional if adding accounts from Web UI)
PHONE_NUMBER=+628123456789
PASSWORD=optional_2fa_password

# Security
JWT_SECRET=super_secret_key_change_me_in_production
JWT_REFRESH_SECRET=super_secret_key_change_me_in_production
ENCRYPTION_KEY=optional_aes_key_defaults_to_jwt_secret
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres
DB_NAME=tele_gateway
DB_PORT=5432


AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# B2B Integration (comma-separated API keys for rotation)
B2B_API_KEYS=change_me_b2b_api_key

# Optional Watchdog (monitors wa-gateway /healthz for crashes or full disconnects)
WATCHDOG_TARGET_URL=
WATCHDOG_HEALTH_TOKEN=
WATCHDOG_INTERVAL_SECONDS=60
WATCHDOG_FAIL_THRESHOLD=2
WATCHDOG_SERVICE_NAME=wa-gateway
WATCHDOG_ALERT_CHAT_ID=0
WATCHDOG_ALERT_TOPIC_ID=0
WATCHDOG_ALERT_USERNAME=
